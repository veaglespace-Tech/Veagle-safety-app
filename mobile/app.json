{
  "expo": {
    "name": "SakhiSuraksha",
    "slug": "veagle-safety",
    "owner": "veaglespace1",
    "extra": {
      "eas": {
        "projectId": "1fbff418-6a14-4ad6-870c-9ba1fb381634"
      }
    },
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/logo_attractive.png",
    "userInterfaceStyle": "light",
    "scheme": "veaglesafety",
    "backgroundColor": "#FFF0F3",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.veaglesafety.app",
      "buildNumber": "3",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SakhiSuraksha requires your location to determine your real-time position so it can be instantly shared with your trusted Guardians and Organization Administrators during an active SOS emergency.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SakhiSuraksha requires background location access to continuously broadcast your live position to emergency contacts even when your phone is locked or the app is minimized during an active SOS event. This continuous tracking is critical for your safety.",
        "NSLocationAlwaysUsageDescription": "SakhiSuraksha requires background location access to safeguard you and share live coordinates with your guardians during active emergencies.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_attractive.png",
        "backgroundColor": "#FFF0F3"
      },
      "package": "com.veaglesafety.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 14,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.INTERNET",
        "android.permission.CHANGE_NETWORK_STATE",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/logo_attractive.png",
          "color": "#FF2A6D",
          "sounds": ["./assets/sounds/alarm_siren.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo_attractive.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF0F3"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SakhiSuraksha requires background location access to continuously broadcast your live position to emergency contacts even when your phone is locked or the app is minimized during an active SOS event. This continuous tracking is critical for your safety.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-font",
      "expo-asset",
      "expo-status-bar"
    ]
  }
}
