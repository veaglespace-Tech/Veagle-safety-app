datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    Int               @id @default(autoincrement())
  fullName              String
  email                 String            @unique
  phone                 String
  passwordHash          String
  role                  String            @default("USER") // USER, SUPER_ADMIN
  profilePhoto          String?           @db.LongText
  bloodGroup            String?
  address               String?
  city                  String?
  state                 String?
  country               String?
  pincode               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  parentEmail           String?
  medicalNotes          String?
  isEmailVerified       Boolean           @default(false)
  emailOtp              String?
  emailOtpExpiresAt     DateTime?
  resetPasswordToken    String?
  resetPasswordExpiresAt DateTime?
  subscriptionStatus    String            @default("INACTIVE") // INACTIVE, ACTIVE, EXPIRED
  subscriptionExpiresAt DateTime?
  currentPlanId         Int?
  safetyStatus          String            @default("SAFE") // SAFE, SOS_ACTIVE, JOURNEY_ACTIVE
  quickSosMode          String            @default("STANDARD") // STANDARD, SILENT
  onboardingStep        Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  trustedContacts       TrustedContact[]
  sosSessions           SosSession[]
  journeys              Journey[]
  liveShares            LiveShareSession[]
  safetyCheckins        SafetyCheckin[]
  auditLogs             AuditLog[]
  paymentHistories      PaymentHistory[]
  organizationMemberships OrganizationMember[] @relation("OrgMemberUser")
  managedOrganizations   OrganizationMember[] @relation("OrgOwner")
  parentLinks             ParentChildLink[]    @relation("ParentLinks")
  childLinks              ParentChildLink[]    @relation("ChildLinks")
}

model Plan {
  id               Int              @id @default(autoincrement())
  name             String
  description      String?
  basePrice        Float            @default(24.0)
  gstPercentage    Float            @default(18.0)
  totalPrice       Float            @default(28.32)
  durationDays     Int              @default(30)
  features         String?          @db.Text
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  paymentHistories PaymentHistory[]
}

model PaymentHistory {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        Int?
  plan          Plan?    @relation(fields: [planId], references: [id])
  txnid         String   @unique
  amount        Float
  baseAmount    Float
  gstAmount     Float
  gstPercentage Float
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  payuMoneyId   String?
  paymentMode   String?
  hash          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model TrustedContact {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  relationship  String
  phone         String
  email         String
  isVerified    Boolean  @default(true)
  priorityOrder Int      @default(1)
  createdAt     DateTime @default(now())
}

model SosSession {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id])
  status         String        @default("ACTIVE") // ACTIVE, RESOLVED, CANCELLED
  isSilent       Boolean       @default(false)
  shareToken     String        @unique @default(uuid())
  startedAt      DateTime      @default(now())
  resolvedAt     DateTime?
  resolutionNote String?
  locations      SosLocation[]
  alerts         SosAlert[]
}

model SosLocation {
  id           Int        @id @default(autoincrement())
  sosSessionId Int
  sosSession   SosSession @relation(fields: [sosSessionId], references: [id], onDelete: Cascade)
  latitude     Float
  longitude    Float
  accuracy     Float?
  altitude     Float?
  speed        Float?
  heading      Float?
  recordedAt   DateTime   @default(now())
}

model SosAlert {
  id           Int        @id @default(autoincrement())
  sosSessionId Int
  sosSession   SosSession @relation(fields: [sosSessionId], references: [id])
  channel      String     // EMAIL, SMS, WEBSOCKET
  recipient    String
  status       String     @default("SENT") // SENT, FAILED
  sentAt       DateTime   @default(now())
}

model LiveShareSession {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  shareToken      String   @unique
  durationMinutes Int
  expiresAt       DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Journey {
  id              Int               @id @default(autoincrement())
  userId          Int
  user            User              @relation(fields: [userId], references: [id])
  originName      String
  destinationName String
  originLat       Float
  originLng       Float
  destLat         Float
  destLng         Float
  expectedArrival DateTime
  status          String            @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, OVERDUE, ESCALATED
  shareToken      String            @unique
  startedAt       DateTime          @default(now())
  completedAt     DateTime?
  locations       JourneyLocation[]
}

model JourneyLocation {
  id         Int      @id @default(autoincrement())
  journeyId  Int
  journey    Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())
}

model SafetyCheckin {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  intervalMins Int
  triggerAt    DateTime
  status       String    @default("PENDING") // PENDING, CONFIRMED_SAFE, EXPIRED_ESCALATED
  createdAt    DateTime  @default(now())
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("SUPER_ADMIN") // SUPER_ADMIN
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String   @db.Text
  ipAddress String?
  createdAt DateTime @default(now())
}

// Web Push Notification Subscription - Linked to user email
// Contacts subscribe once → receive emergency alarms even with browser closed
model PushSubscription {
  id          Int      @id @default(autoincrement())
  userEmail   String
  endpoint    String   @unique @db.VarChar(500)
  p256dh      String   @db.Text
  auth        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactEnquiry {
  id             Int       @id @default(autoincrement())
  fullName       String
  email          String
  phone          String?
  subject        String?
  message        String    @db.Text
  status         String    @default("PENDING") // PENDING, RESOLVED
  resolutionNote String?   @db.Text
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model OrganizationMember {
  id             Int      @id @default(autoincrement())
  organizationId Int
  organization   User     @relation("OrgOwner", fields: [organizationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User     @relation("OrgMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  memberCode     String?
  department     String?
  status         String   @default("ACTIVE") // ACTIVE, PENDING
  createdAt      DateTime @default(now())

  @@unique([organizationId, userId])
}

model ParentChildLink {
  id           Int      @id @default(autoincrement())
  parentId     Int
  parent       User     @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  childId      Int
  child        User     @relation("ChildLinks", fields: [childId], references: [id], onDelete: Cascade)
  relationship String   @default("Parent")
  linkingCode  String?
  status       String   @default("ACTIVE") // ACTIVE, PENDING
  createdAt    DateTime @default(now())

  @@unique([parentId, childId])
}
